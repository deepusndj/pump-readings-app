# Copy this file to .env (locally) or set these as environment variables
# in your hosting provider's dashboard (e.g. Render).

# The password the owner uses to unlock Owner mode in the app.
# Change this to something only you know before deploying!
OWNER_PASSWORD=changeme

# Where the SQLite database file is stored. Leave unset to default to
# backend/pump_readings.db. On Render, point this at a path inside a
# persistent disk (see README) so data survives restarts/deploys.
# PUMP_DB_PATH=/data/pump_readings.db
